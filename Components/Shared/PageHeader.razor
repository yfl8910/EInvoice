<header class="mb-4">
    @if (!string.IsNullOrEmpty(BackHref)) { <a href="@BackHref">← @BackText</a> }
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-2">
        <div><h1 class="mb-1">@Title</h1>@if (!string.IsNullOrEmpty(Description)) { <p class="text-muted mb-0">@Description</p> }</div>
        @if (Actions is not null) { <div class="d-flex flex-wrap gap-2">@Actions</div> }
    </div>
</header>
@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? BackHref { get; set; }
    [Parameter] public string BackText { get; set; } = "All invoices";
    [Parameter] public RenderFragment? Actions { get; set; }
}
