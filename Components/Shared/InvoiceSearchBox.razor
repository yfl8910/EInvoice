<input class="form-control form-control-sm invoice-search" aria-label="Search invoices" placeholder="Search invoice, supplier or buyer" value="@Value" @oninput="Changed" />
@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    Task Changed(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString() ?? "");
}
