@page "/invoices/analysis"
@using EInvoice.Web.Data
@using EInvoice.Web.Services
@inject InvoiceStore Store
<PageTitle>Invoice analysis</PageTitle>
<PageHeader Title="Invoice Analysis" Description="Summarize saved invoices by Supplier and Buyer." />
<InvoiceAnalysisFilters @bind-Value="filter" Currencies="@invoices.Select(x => x.Currency)" />
@if (loading) { <p role="status">Loading…</p> }
else if (failed) { <p role="alert">Could not load invoices. Please refresh the page to try again.</p> }
else if (filter.InvalidDateRange) { <p class="alert alert-warning" role="alert">The start date must be on or before the end date.</p> }
else {
    var filtered = invoices.Where(filter.Matches).ToList();
    var summaries = InvoiceAnalysis.Summarize(filtered, filter.Dimension);
    <p role="status">@filtered.Count invoices · @summaries.Count groups</p>
    @if (filtered.Count == 0) { <p>No invoices match these filters. Adjust the filters or go to <a href="/invoices/import">Invoice Upload</a> to save invoices.</p> }
    else {
        <CurrencySummaryCards Totals="@InvoiceAnalysis.Summarize(filtered, "Currency")" />
        <InvoiceAnalysisTable Rows="@summaries" Dimension="@filter.Dimension" />
    }
    <details class="text-muted small mt-3"><summary>About these totals</summary><p class="mt-2">Currencies are reported separately without exchange rate conversion. Invoice date filters include both start and end dates. Missing or invalid dates are excluded when a date filter is applied. Supplier and Buyer groups use original names. Different saved files with the same invoice number are counted separately.</p></details>
}
@code {
    List<Invoice> invoices = [];
    InvoiceAnalysisFilter filter = new();
    bool loading = true, failed;
    protected override async Task OnInitializedAsync()
    {
        try { invoices = await Store.List(); }
        catch { failed = true; }
        finally { loading = false; }
    }
}
