@page "/invoices/{Id:int}"
@using EInvoice.Web.Data
@using EInvoice.Web.Services
@inject InvoiceStore Store
<PageTitle>Invoice details</PageTitle>
<PageHeader Title="Invoice details" BackHref="/" />
@if (invoice is null) { <p class="mt-3">Invoice not found.</p> }
else {
    <InvoicePreview Invoice="@invoice">
        <Actions>
            <InvoiceDownloadActions InvoiceId="@Id" />
        </Actions>
    </InvoicePreview>
}
@code {
    [Parameter] public int Id { get; set; }
    Invoice? invoice;
    protected override async Task OnParametersSetAsync() => invoice = await Store.Get(Id);
}

